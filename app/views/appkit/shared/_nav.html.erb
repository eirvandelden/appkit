<nav class="rail" aria-label="<%= t("appkit.navigation.rail") %>">
  <%= yield %>
  <ul>
    <% menu.hubs.each do |hub| %>
      <li><%= link_to "#{hub.emoji} #{hub.label}", hub.path, "aria-current": (menu.current?(hub) ? "true" : nil) %></li>
    <% end %>
    <li><%= render "appkit/shared/account_menu", menu: menu, user_name: user_name %></li>
  </ul>
</nav>
<% hub = menu.current_hub %>
<% if hub&.pages&.any? %>
  <nav class="hub-column" aria-label="<%= t("appkit.navigation.hub_column") %>">
    <h2><%= link_to hub.label, hub.path %></h2>
    <ul>
      <% hub.pages.each do |page| %>
        <li>
          <%= link_to page.path, "aria-current": (menu.current?(page) ? "page" : nil) do %>
            <%= page.label %>
            <% count = page.count %>
            <%= tag.data(count, value: count) if count&.positive? %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </nav>
<% end %>
