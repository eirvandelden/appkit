<nav class="rail" aria-label="<%= t("appkit.navigation.rail") %>">
  <%= yield %>
  <ul>
    <% menu.hubs.select(&:rail?).each do |hub| %>
      <li>
        <%= link_to hub.path, "aria-current": (menu.current?(hub) ? "true" : nil) do %>
          <%= tag.span(hub.emoji, "aria-hidden": "true") %>
          <%= hub.label %>
        <% end %>
      </li>
    <% end %>
  </ul>
</nav>
<% hub = menu.current_hub %>
<% if hub&.pages&.any? %>
  <nav class="hub-column" aria-label="<%= t("appkit.navigation.hub_column") %>">
    <h2><%= link_to hub.label, hub.path %></h2>
    <ul>
      <% hub.pages.each do |page| %>
        <li>
          <%= menu_entry_to page.path, page, "aria-current": (menu.current?(page) ? "page" : nil) do %>
            <%= page.label %>
            <% count = page.count %>
            <%= tag.data(count, value: count) if count&.positive? %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </nav>
<% end %>
