<!DOCTYPE html>
<html>
  <head>
    <title><%= Appkit.config.app_display_name %></title>
    <%= csrf_meta_tags %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <header>
      <%= render layout: "appkit/shared/nav", locals: { menu: menu } do %>
      <% end %>
    </header>
    <main>
      <% back = menu.back %>
      <% if back %>
        <header><nav><%= link_to "‹ #{back.label}", back.path, class: "back" %></nav></header>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
