<!DOCTYPE html>
<html>
  <head>
    <title><%= Appkit.config.app_display_name %></title>
  </head>
  <body>
    <header>
      <%= render layout: "appkit/shared/nav", locals: { menu: menu, user_name: Current.user.email } do %>
      <% end %>
    </header>
    <% back = menu.back %>
    <%= link_to "‹ #{back.label}", back.path, class: "back" if back %>
    <main><%= yield %></main>
  </body>
</html>
